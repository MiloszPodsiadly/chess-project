{
  "name": "chess-web",
  "version": "0.0.0",
  "scripts": {
    "postinstall": "node scripts/sync-stockfish-assets.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "review:arena": "node scripts/review-arena.mjs",
    "review:multiplayer": "playwright test --config=playwright.config.mjs",
    "test:e2e:multiplayer": "playwright test --config=playwright.config.mjs",
    "test:engine": "node scripts/verify-stockfish.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@stomp/stompjs": "^7.1.0",
    "chess.js": "^1.4.0",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "stockfish": "19.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.2.25",
    "@playwright/test": "^1.64.1",
    "@types/sockjs-client": "^1.5.4",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
